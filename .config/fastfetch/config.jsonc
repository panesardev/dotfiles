{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
  "logo": {
    "source": "~/.config/fastfetch/arch.txt",
    "color": {
      "1": "default"
    }
  },
  "display": {
    "separator": "  ", // :
    "color": "default"
  },
  "modules": [
    {
      "type": "title"
    },
    "break",
    {
      "type": "custom",
      "format": "┌─────────────────────────────────────────────────────────────┐",
      "color": "default"
    },
    {
      "type": "os",
      "key": ""
    },
    {
      "type": "kernel",
      "key": ""
    },
    {
      "type": "de",
      "key": ""
    },
    {
      "type": "wm",
      "key": ""
    },
    {
      "type": "custom",
      "format": "├─────────────────────────────────────────────────────────────┤",
      "color": "default"
    },
    {
      "type": "cpu",
      "key": ""
    },
    {
      "type": "gpu",
      "key": ""
    },
    {
      "type": "memory",
      "key": ""
    },
    {
      "type": "swap",
      "key": ""
    },
    {
      "type": "disk",
      "key": ""
    },
    {
      "type": "custom",
      "format": "├─────────────────────────────────────────────────────────────┤",
      "color": "default"
    },
    {
      "type": "uptime",
      "key": ""
    },
    {
      "type": "terminal",
      "key": ""
    },
    {
      "type": "custom",
      "format": "└─────────────────────────────────────────────────────────────┘",
      "color": "default"
    },
    "break"
  ]
}