{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
  "logo": {
    "source": "~/.config/fastfetch/arch.txt",
  },
  "display": {
    "separator": "  " // :
  },
  "modules": [
    {
      "type": "title"
    },
    "break",
    {
      "type": "custom",
      "format": "\u001b[90m┌────────────────────────────────────────────────────────────┐"
    },
    {
      "type": "os",
      "key": "",
      "keycolor": "red"
    },
    {
      "type": "kernel",
      "key": "",
      "keycolor": "red"
    },
    {
      "type": "de",
      "key": "",
      "keycolor": "green"
    },
    {
      "type": "wm",
      "key": "",
      "keycolor": "green"
    },
    {
      "type": "custom",
      "format": "\u001b[90m├─────────────────────────────────────────────────────────────┤"
    },
    {
      "type": "cpu",
      "key": "",
      "keycolor": "blue"
    },
    {
      "type": "gpu",
      "key": "",
      "keycolor": "magenta"
    },
    {
      "type": "memory",
      "key": "",
      "keycolor": "blue"
    },
    {
      "type": "swap",
      "key": "",
      "keycolor": "magenta"
    },
    {
      "type": "disk",
      "key": "",
      "keycolor": "red"
    },
    {
      "type": "custom",
      "format": "\u001b[90m├─────────────────────────────────────────────────────────────┤"
    },
    {
      "type": "uptime",
      "key": "",
      "keycolor": "yellow"
    },
    {
      "type": "terminal",
      "key": "",
      "keycolor": "yellow"
    },
    {
      "type": "custom",
      "format": "\u001b[90m└────────────────────────────────────────────────────────────┘"
    },
    "break",
  ]
}